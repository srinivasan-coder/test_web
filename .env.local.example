# Password required to sign in at /admin
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin login session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Gmail SMTP — used to send contact form enquiries.
# GMAIL_USER is the sending Gmail address (2-Step Verification must be on).
# GMAIL_APP_PASSWORD is a 16-character App Password generated at
# https://myaccount.google.com/apppasswords — NOT your normal Gmail password.
GMAIL_USER=fotolitestudioz@gmail.com
GMAIL_APP_PASSWORD=replace-with-a-16-char-app-password

# Firebase Admin SDK (Firestore) — from a service account JSON generated at
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# Cloudinary — used for admin image uploads. From the Cloudinary dashboard
# (Product Environment card) and Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
